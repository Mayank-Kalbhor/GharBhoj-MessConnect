# =====================================================================
# MessConnect — .env.example
# Version: 1.0 | Date: September 15, 2026
#
# This is the single source of truth for every environment variable the
# platform needs. Copy to `.env` in each app (apps/api/.env, apps/web/.env.local,
# apps/mobile/.env) and fill in real values — NEVER commit a filled-in .env file.
#
# Rule for AI assistants: only reference variable names that appear in this
# file. If a new integration needs a new variable, add it here first (with a
# comment explaining it) before referencing it in code — never invent a key
# name inline or hardcode a literal value "to get it working for now."
# =====================================================================

# ---------------------------------------------------------------------
# apps/api — NestJS backend
# ---------------------------------------------------------------------

# --- App ---
NODE_ENV=development                      # development | staging | production
PORT=4000
API_BASE_URL=http://localhost:4000         # used for building absolute webhook/callback URLs
CORS_ORIGIN=http://localhost:3000          # comma-separated list of allowed web/mobile origins

# --- Auth (JWT issued by our backend after Firebase verification) ---
JWT_SECRET=                                # long random string; rotate via AWS Secrets Manager in production, never hardcode
JWT_EXPIRES_IN=7d

# --- Database (PostgreSQL via Amazon RDS — matches schema.prisma's env("DATABASE_URL")) ---
DATABASE_URL=postgresql://user:password@localhost:5432/messconnect_dev
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public

# --- Redis (Amazon ElastiCache — caching + BullMQ queue backend) ---
REDIS_URL=redis://localhost:6379

# --- Firebase Admin SDK (server-side token verification) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=                      # keep the literal \n escapes if loaded from a single-line env var

# --- Razorpay (payments + Route payouts) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                   # used to verify X-Razorpay-Signature on POST /payments/razorpay-webhook

# --- Google Maps Platform (Places, Geocoding, Directions) ---
GOOGLE_MAPS_SERVER_API_KEY=                # server-side key, separate from the client-side key below — restrict by API + IP

# --- MSG91 (SMS / WhatsApp OTP and transactional messages) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID_OTP=
MSG91_TEMPLATE_ID_ORDER_UPDATE=
MSG91_TEMPLATE_ID_SUBSCRIPTION_REMINDER=

# --- AWS (S3, CloudFront, Secrets Manager, CloudWatch) ---
AWS_REGION=ap-south-1                      # Mumbai region
AWS_ACCESS_KEY_ID=                         # prefer an IAM role in ECS over static keys in production
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=messconnect-media
AWS_CLOUDFRONT_DOMAIN=                     # e.g. https://cdn.messconnect.in

# --- MVP shortcut alternative (only if using Railway/Render instead of AWS — pick one path, per TechStack_MessConnect.md §13) ---
# RAILWAY_STATIC_URL=
# RENDER_DISK_PATH=

# --- Sentry (error tracking) ---
SENTRY_DSN_API=

# --- Platform defaults (non-secret business config; can also live in packages/shared-constants) ---
DEFAULT_SKIP_CREDIT_CAP_PERCENT=25         # used when SubscriptionPlan.maxSkipCredits is unset — see BusinessLogic_MessConnect.md Rule 3
DEFAULT_PAGE_SIZE=20
DAILY_MENU_CACHE_TTL_SECONDS=15            # matches API_Contract_MessConnect.md §5 GET /mess/:id/menu caching note


# ---------------------------------------------------------------------
# apps/web — Next.js vendor dashboard + admin panel
# Note: NEXT_PUBLIC_* variables are exposed to the browser bundle — never
# put a secret key behind this prefix.
# ---------------------------------------------------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# --- Firebase client SDK (for phone OTP / Google / Apple login in the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps Platform (client-side key — restrict by HTTP referrer + API) ---
NEXT_PUBLIC_GOOGLE_MAPS_CLIENT_API_KEY=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN_WEB=


# ---------------------------------------------------------------------
# apps/mobile — React Native (Expo) customer app
# Note: Expo env vars need the EXPO_PUBLIC_ prefix to be available at
# runtime in the client bundle — same "never put a secret here" rule.
# ---------------------------------------------------------------------

EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# --- Firebase client SDK ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Maps Platform (client-side key, mobile-restricted) ---
EXPO_PUBLIC_GOOGLE_MAPS_CLIENT_API_KEY=

# --- Firebase Cloud Messaging (push notifications) ---
EXPO_PUBLIC_FCM_SENDER_ID=

# --- Sentry ---
EXPO_PUBLIC_SENTRY_DSN_MOBILE=


# ---------------------------------------------------------------------
# CI/CD (GitHub Actions repository secrets — NOT committed here, listed
# for reference so nothing is set up ad hoc in the Actions UI)
# ---------------------------------------------------------------------
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  (deploy-scoped IAM user, separate from the runtime one above)
# ECR_REPOSITORY_URI
# ECS_CLUSTER_NAME
# ECS_SERVICE_NAME
# DATABASE_URL (staging/production, injected at deploy time — never the same value as local dev above)
