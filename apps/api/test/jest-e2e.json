{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@messconnect/shared-constants$": "<rootDir>/../../packages/shared-constants/src",
    "^@messconnect/shared-types$": "<rootDir>/../../packages/shared-types/src"
  }
}
